{
  "name": "@focuson/components",
  "description": "The core react components for focuson",
  "version": "2.0.0",
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "@focuson/events": "2.0.0",
    "@focuson/lens": "2.0.0",
    "@focuson/state": "2.0.0",
    "@focuson/utils": "2.0.0",
    "debug": ""
  },
  "devDependencies": {
    "@babel/preset-react": "",
    "@types/react": "",
    "@types/react-dom": "",
    "parcel": "2.9.3",
    "typescript": "5.6.3"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/",
    "build/"
  ],
  "keywords": [
    "react",
    "runbook"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "repository": " git@github.com:focuson-ts/focuson.git",
  "scripts": {
    "start": "parcel src/index.html",
    "build": "parcel build src/index.html",
    "test": "jest --config jest.config.json",
    "test:watch": "npm run test -- --watch"
  }
}