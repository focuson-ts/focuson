{
  "name": "${packageDetails.name}",
  "description": "${packageDetails.description}",
  "version": "${version}",
  "license": "${properties.license}",
  "repository": "${properties.repository}",
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "react": "${properties.react}",
    "react-dom": "${properties.react-dom}",
    "@testing-library/jest-dom": "${properties.@testing-library/jest-dom}",
    "@testing-library/react": "${properties.@testing-library/react}",
    "@testing-library/user-event": "${properties.@testing-library/user-event}",
    "web-vitals": "${properties.web-vitals}"
  },
  "devDependencies": {
    "@types/jest": "${properties.@types/jest}",
    "@types/node": "${properties.@types/node}",
    "@types/react": "${properties.@types/react}",
    "@types/react-dom": "${properties.@types/react-dom}",
    "typescript": "${properties.typescript}",
    "parcel": "${properties.parcel}"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/",
    "build/"
  ],
  "keywords": [
    "react",
    "runbook"
  ],
  "scripts": {
    "start": "parcel public/index.html",
    "build": "parcel build public/index.html",
    "test": "jest --config jest.config.json",
    "test:watch": "npm run test -- --watch"
  }
}
