{
  "name": "${packageDetails.name}",
  "description": "${packageDetails.description}",
  "version": "${version}",
  "license": "${properties.license}",
  "repository": "${properties.repository}",
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "debug": "${properties.debug}"
  },
  "peerDependencies": {
    "react": "${properties.react}",
    "react-dom": "${properties.react-dom}"
  },
  "devDependencies": {
    "@babel/preset-react": "${properties.babelPresetReact}",
    "@types/react": "${properties.typesReact}",
    "@types/react-dom": "${properties.typesReactDom}",
    "parcel": "${properties.parcel}",
    "typescript": "${properties.typescript}"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.stories.*"
        ],
        "rules": {
          "import/no-anonymous-default-export": "off"
        }
      }
    ]
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src/",
    "build/"
  ],
  "keywords": [
    "react",
    "runbook"
  ],
  "scripts": {
    "start": "parcel src/index.html",
    "build": "parcel build src/index.html",
    "test": "jest --config jest.config.json",
    "test:watch": "npm run test -- --watch"
  }
}
